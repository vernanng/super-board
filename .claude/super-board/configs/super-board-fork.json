{
  "version": 1,
  "description": "super-board fork — OpenCode dogfood",
  "project": {
    "owner": "vernanng",
    "title": "Super-board-fork board",
    "number": 1
  },
  "worker_backend": "opencode",
  "model_tier": "medium",
  "codex": { "model": null },
  "target": { "type": "repo", "url": null },
  "repo": { "path": ".", "remote": "https://github.com/vernanng/super-board" },
  "base_branch": "staging",
  "timezone": "Asia/Jakarta",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "allowed_envs": ["test", "staging"],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": ["bash tests/run-safety.sh"],
  "max_workers": 0,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": ["github", "prs", "architecture"],
    "window_days": 14,
    "prs": { "max_prs": 200 },
    "architecture": { "max_findings": 5 },
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "vernanng"
  }
}